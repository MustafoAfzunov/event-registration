# Copy to .env (`make up` does this automatically if .env is missing).
# DEV-ONLY values. Never reuse these anywhere real.

# --- Postgres ---
POSTGRES_USER=eventreg
POSTGRES_PASSWORD=eventreg
POSTGRES_DB=eventreg

# --- Host ports (change if they clash with something on your machine) ---
FRONTEND_PORT=8080
BACKEND_PORT=8000
DB_PORT=5433
MAILPIT_UI_PORT=8025
MAILPIT_SMTP_PORT=1025

# --- App ---
APP_ENV=development
# Organizer login password (min 8 chars) and cookie-signing secret (min 32 chars).
ORGANIZER_PASSWORD=organizer-dev-password
SESSION_SECRET=dev-only-session-secret-change-me-0123456789
# Base URL used in email links (manage/cancel link).
PUBLIC_BASE_URL=http://localhost:8080

# --- Email worker (optional; defaults shown). SMTP_HOST/PORT are set to the mailpit service in compose.
# OUTBOX_BATCH_SIZE=10
# OUTBOX_LEASE_SECONDS=120          # must exceed BATCH_SIZE * (SMTP_TIMEOUT_SECONDS + OUTBOX_SEND_INTERVAL_SECONDS)
# OUTBOX_MAX_ATTEMPTS=8
# OUTBOX_BACKOFF_BASE_SECONDS=5
# OUTBOX_BACKOFF_MAX_SECONDS=3600
# SMTP_TIMEOUT_SECONDS=10
